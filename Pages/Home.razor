@page "/"
@using SpesaCondivisa.Services
@implements IDisposable
@inject ListaService Lista
@inject Impostazioni Imp
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Spesa</PageTitle>

@if (!caricato)
{
    <p class="centro tenue">Caricamento…</p>
}
else if (!Lista.Configurato)
{
    <section class="benvenuto">
        <div class="logo">🛒</div>
        <h1>Manca il database</h1>
        <p class="tenue">Inserisci l’indirizzo del tuo Firebase Realtime Database nel file
            <code>wwwroot/appsettings.json</code> e pubblica di nuovo l’app.</p>
    </section>
}
else if (!Imp.Completa || inImpostazioni)
{
    <section class="benvenuto">
        <div class="logo">🛒</div>
        <h1>@(Imp.Completa ? "Impostazioni" : "Spesa condivisa")</h1>
        <p class="tenue">Usate lo stesso codice lista sui due telefoni per vedere la stessa lista.</p>

        <div class="scheda modulo">
            <label for="nome">Il tuo nome</label>
            <input id="nome" @bind="nomeInput" placeholder="Es. Francesco" autocomplete="given-name" />

            <label for="codice">Codice lista</label>
            <input id="codice" @bind="codiceInput" placeholder="Es. k7m2-p9x4-q3w8"
                   autocapitalize="off" autocorrect="off" spellcheck="false" />
            <button class="link" @onclick="() => codiceInput = Impostazioni.GeneraCodice()">
                Non ce l’hai? Genera un nuovo codice
            </button>
        </div>

        @if (erroreImpostazioni is not null)
        {
            <p class="errore">@erroreImpostazioni</p>
        }

        <button class="primario largo" @onclick="SalvaImpostazioni">@(Imp.Completa ? "Salva" : "Inizia")</button>
        @if (Imp.Completa)
        {
            <button class="link largo" @onclick="() => inImpostazioni = false">Annulla</button>
        }
    </section>
}
else
{
    <div class="barra">
        <header class="testata">
            <div>
                <p class="saluto">Ciao @Imp.Nome 👋</p>
                <h1>Spesa</h1>
            </div>
            <div class="azioni">
                <button class="icona" title="Invita" aria-label="Invita" @onclick="Invita">
                    <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6M22 11h-6" /></svg>
                </button>
                <button class="icona" title="Impostazioni" aria-label="Impostazioni" @onclick="ApriImpostazioni">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                </button>
            </div>
        </header>

        <form class="aggiungi" @onsubmit="Aggiungi">
            <input @bind="nuovoTesto" @bind:event="oninput" placeholder="Cosa serve?" enterkeyhint="done" maxlength="80" aria-label="Nuovo articolo" />
            <button class="piu" type="submit" aria-label="Aggiungi" disabled="@string.IsNullOrWhiteSpace(nuovoTesto)">
                <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
            </button>
        </form>
    </div>

    @if (articoli.Count == 0)
    {
        <div class="vuoto">
            <div class="vuoto-icona">🧺</div>
            <h2>La lista è vuota</h2>
            <p class="tenue">Scrivi qui sopra la prima cosa da comprare.</p>
        </div>
    }
    else
    {
        <div class="titolo-sezione">
            <span>Da prendere <span class="conteggio">@DaPrendere.Count()</span></span>
        </div>

        @if (!DaPrendere.Any())
        {
            <div class="vuoto piccolo">
                <div class="vuoto-icona">🎉</div>
                <h2>Tutto preso!</h2>
            </div>
        }
        else
        {
            <ul class="lista">
                @foreach (var a in DaPrendere)
                {
                    <li @key="a.Id" class="voce">
                        <button class="tocca" @onclick="() => Cambia(a)" aria-label="Segna @a.Testo come preso">
                            <span class="spunta"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
                            <span class="emoji">@Icone.Per(a.Testo)</span>
                            <span class="testo">
                                <span class="nome">@a.Testo</span>
                                <small>@a.AggiuntoDa · @Quando(a.Creato)</small>
                            </span>
                        </button>
                        <button class="elimina" aria-label="Elimina @a.Testo" @onclick="() => Elimina(a)">
                            <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg>
                        </button>
                    </li>
                }
            </ul>
        }

        @if (Presi.Any())
        {
            <div class="titolo-sezione">
                <button class="espandi" @onclick="() => mostraPresi = !mostraPresi" aria-expanded="@mostraPresi">
                    Già presi <span class="conteggio">@Presi.Count()</span>
                    <svg class="freccia @(mostraPresi ? "aperta" : "")" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg>
                </button>
                <button class="link" @onclick="SvuotaPresi">Svuota</button>
            </div>

            @if (mostraPresi)
            {
                <ul class="lista presi">
                    @foreach (var a in Presi)
                    {
                        <li @key="a.Id" class="voce">
                            <button class="tocca" @onclick="() => Cambia(a)" aria-label="Rimetti @a.Testo da prendere">
                                <span class="spunta"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
                                <span class="emoji">@Icone.Per(a.Testo)</span>
                                <span class="testo">
                                    <span class="nome">@a.Testo</span>
                                    <small>preso da @a.PresoDa</small>
                                </span>
                            </button>
                            <button class="elimina" aria-label="Elimina @a.Testo" @onclick="() => Elimina(a)">
                                <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg>
                            </button>
                        </li>
                    }
                </ul>
            }
        }
    }

    <p class="piede">Lista <strong>@Imp.Codice</strong></p>
}

@if (messaggio is not null)
{
    <div class="avviso @(messaggio == MsgOffline ? "offline" : "")" role="status" @onclick="() => messaggio = null">@messaggio</div>
}

@code {
    [SupplyParameterFromQuery(Name = "lista")] public string? ListaDaLink { get; set; }

    private List<Articolo> articoli = [];
    private bool caricato, inImpostazioni, occupato, mostraPresi = true;
    private string nuovoTesto = "", nomeInput = "", codiceInput = "";
    private string? messaggio, erroreImpostazioni;
    private readonly CancellationTokenSource cts = new();

    private IEnumerable<Articolo> DaPrendere => articoli.Where(a => !a.Preso).OrderBy(a => a.Creato);
    private IEnumerable<Articolo> Presi => articoli.Where(a => a.Preso).OrderBy(a => a.Testo, StringComparer.CurrentCultureIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await Imp.CaricaAsync();
        nomeInput = Imp.Nome;
        codiceInput = Imp.Codice;

        // Aperto da un link di invito: proponi quel codice.
        if (!string.IsNullOrWhiteSpace(ListaDaLink))
        {
            var codiceLink = Impostazioni.NormalizzaCodice(ListaDaLink);
            if (codiceLink != Imp.Codice)
            {
                codiceInput = codiceLink;
                inImpostazioni = true;
            }
            Nav.NavigateTo(Nav.BaseUri, replace: true);
        }

        if (Imp.Completa && Lista.Configurato) await Aggiorna();
        caricato = true;
        _ = AggiornamentoPeriodico();
    }

    private async Task AggiornamentoPeriodico()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                if (occupato || inImpostazioni || !Imp.Completa || !Lista.Configurato) continue;
                await Aggiorna();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task Aggiorna()
    {
        try
        {
            var nuovi = await Lista.CaricaAsync(Imp.Codice);
            if (!occupato) articoli = nuovi;
            if (messaggio == MsgOffline) messaggio = null;
        }
        catch (Exception)
        {
            messaggio = MsgOffline;
        }
    }

    private const string MsgOffline = "Non riesco a collegarmi. Controlla la connessione.";

    /// <summary>Mostra un avviso che sparisce da solo dopo qualche secondo.</summary>
    private async void Avvisa(string testo)
    {
        messaggio = testo;
        StateHasChanged();
        await Task.Delay(3500);
        if (messaggio == testo)
        {
            messaggio = null;
            StateHasChanged();
        }
    }

    private static string Quando(long creatoMs)
    {
        var diff = DateTimeOffset.UtcNow - DateTimeOffset.FromUnixTimeMilliseconds(creatoMs);
        if (diff.TotalMinutes < 1) return "adesso";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} min fa";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} h fa";
        if (diff.TotalDays < 2) return "ieri";
        return $"{(int)diff.TotalDays} giorni fa";
    }

    private async Task SalvaImpostazioni()
    {
        erroreImpostazioni = null;
        var codice = Impostazioni.NormalizzaCodice(codiceInput);
        if (string.IsNullOrWhiteSpace(nomeInput)) { erroreImpostazioni = "Scrivi il tuo nome."; return; }
        if (codice.Length < 6) { erroreImpostazioni = "Il codice lista deve avere almeno 6 caratteri."; return; }

        await Imp.SalvaAsync(nomeInput, codice);
        codiceInput = Imp.Codice;
        inImpostazioni = false;
        articoli = [];
        await Aggiorna();
    }

    private void ApriImpostazioni()
    {
        nomeInput = Imp.Nome;
        codiceInput = Imp.Codice;
        erroreImpostazioni = null;
        inImpostazioni = true;
    }

    private async Task Aggiungi()
    {
        var testo = nuovoTesto.Trim();
        if (testo.Length == 0) return;

        if (articoli.Any(a => !a.Preso && string.Equals(a.Testo, testo, StringComparison.CurrentCultureIgnoreCase)))
        {
            Avvisa($"“{testo}” è già nella lista.");
            nuovoTesto = "";
            return;
        }

        await Esegui(async () =>
        {
            var a = await Lista.AggiungiAsync(Imp.Codice, testo, Imp.Nome);
            articoli.Add(a);
            nuovoTesto = "";
        });
    }

    private Task Cambia(Articolo a) => Esegui(async () =>
    {
        var preso = !a.Preso;
        await Lista.ImpostaPresoAsync(Imp.Codice, a.Id, preso, Imp.Nome);
        a.Preso = preso;
        a.PresoDa = preso ? Imp.Nome : null;
    });

    private Task Elimina(Articolo a) => Esegui(async () =>
    {
        await Lista.EliminaAsync(Imp.Codice, a.Id);
        articoli.Remove(a);
    });

    private async Task SvuotaPresi()
    {
        var presi = Presi.ToList();
        if (!await JS.InvokeAsync<bool>("confirm", $"Rimuovere {presi.Count} articoli già presi?")) return;
        await Esegui(async () =>
        {
            await Lista.EliminaTantiAsync(Imp.Codice, presi.Select(a => a.Id));
            articoli.RemoveAll(presi.Contains);
        });
    }

    private async Task Invita()
    {
        var link = $"{Nav.BaseUri}?lista={Uri.EscapeDataString(Imp.Codice)}";
        var esito = await JS.InvokeAsync<string>("spesa.condividi", "Spesa condivisa",
            $"Usiamo questa lista della spesa. Codice lista: {Imp.Codice}", link);
        if (esito == "copiato") Avvisa("Link copiato: mandalo alla tua compagna.");
    }

    /// <summary>Esegue una modifica bloccando l'aggiornamento automatico, poi riallinea con il database.</summary>
    private async Task Esegui(Func<Task> azione)
    {
        if (occupato) return;
        occupato = true;
        try
        {
            await azione();
            if (messaggio == MsgOffline) messaggio = null;
        }
        catch (Exception)
        {
            Avvisa("Modifica non salvata: controlla la connessione e riprova.");
        }
        finally
        {
            occupato = false;
        }
        await Aggiorna();
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
